# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
dist/
release/

# IDE / agent tooling
.idea/
.claude/

# Personal AI-agent notes - every contributor keeps their own, never committed
/.ai/

# Local scratch files (personal notes, debug dumps, screenshots)
bugs.txt
gem-ideas.txt
loot_debug.txt
issues.md
screenshot_*.png
shot*.png
snap_*.png
skin_*.png

# Stash dir used by scripts/build_release.py --no-private-packs
.private_packs_tmp/

# Desert environment: only the open-source desert tileset (Amstrad
# CC-BY-SA 3.0) is tracked; local leftovers stay untracked.
/assets/environment/*
!/assets/environment/README.md
!/assets/environment/tileset_desert.png
!/assets/environment/plain_*.png
!/assets/environment/brush_*.png
!/assets/environment/path_tiles.png


# Kit source files (GIMP projects) stay local 
# rendered PNGs are tracked
/assets/gui/*.xcf

# Source WAVs stay local - OGG conversions are tracked (see assets/ost/credits.txt)
/assets/ost/*.wav
/steam-assets
*.zip

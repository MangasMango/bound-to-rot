# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
dist/
release/

# IDE / agent tooling
.idea/
.claude/

# Personal AI-agent notes — every contributor keeps their own, never committed
/.ai/

# Local scratch files (personal notes, debug dumps, screenshots)
bugs.txt
gem-ideas.txt
loot_debug.txt
issues.md
screenshot_*.png
shot*.png
snap_*.png
skin_*.png

# Stash dir used by scripts/build_release.py --no-private-packs
.private_packs_tmp/

# Leftover metadata from the non-redistributable pack
/assets/Licence.txt
/assets/Asset Index.txt
/assets/Animation Index.txt
/assets/+ Update.txt

# Non-redistributable asset packs — contents ignored, README placeholder stays
/assets/boss/*
!/assets/boss/README.md
/assets/enemy/*
!/assets/enemy/README.md
/assets/none-playable character/*
!/assets/none-playable character/README.md
/assets/playable character/*
!/assets/playable character/README.md

# Desert environment is open-source (Amstrad CC-BY-SA 3.0) — track it.
# Everything else in environment/ (LoP leftovers, OFDN backup tiles) stays local.
/assets/environment/*
!/assets/environment/README.md
!/assets/environment/tileset_desert.png
!/assets/environment/plain_*.png
!/assets/environment/brush_*.png

# Sliced desert props under prop/desert/ are tracked; every other prop
# directory (still the Lords-of-Pain pack locally) stays ignored
/assets/prop/*
!/assets/prop/README.md
!/assets/prop/desert/
!/assets/prop/desert/**
!/assets/vfx/README.md

# Kit source files (GIMP projects) stay local � rendered PNGs are tracked
/assets/gui/*.xcf

# Source WAVs stay local � OGG conversions are tracked (see assets/ost/credits.txt)
/assets/ost/*.wav
/steam-assets
*.zip
